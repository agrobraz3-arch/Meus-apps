{
  "entities": {
    "products": {
      "title": "Product",
      "description": "Store products catalog including ties, bow ties, and wedding sets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "fabric": { "type": "string" },
        "width": { "type": "string" },
        "length": { "type": "string" },
        "color": { "type": "string" },
        "colorLabel": { "type": "string" },
        "pattern": { "type": "string" },
        "occasion": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "isBestSeller": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "isWeddingFav": { "type": "boolean" },
        "includes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "category", "price", "images", "stock"]
    },
    "orders": {
      "title": "Order",
      "description": "Customer orders placed in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "date": { "type": "string" },
        "items": { "type": "array" },
        "customer": { "type": "object" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "trackingCode": { "type": "string" }
      },
      "required": ["id", "orderNumber", "total", "items", "customer"]
    },
    "storeSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and payment details",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "pixKey": { "type": "string" },
        "pixKeyType": { "type": "string" },
        "pixDiscountPercent": { "type": "number" },
        "freeShippingThreshold": { "type": "number" }
      }
    },
    "customers": {
      "title": "Customer",
      "description": "Registered customer accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "cpf": { "type": "string" },
        "address": { "type": "object" }
      },
      "required": ["id", "name", "phone"]
    }
  }
}
